<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>地学 一問一答クイズ</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: #f4f4f6;
      color: #111;
      height: 100vh;
      width: 100vw;
      overflow: hidden;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    #app {
      width: 100%;
      max-width: 480px;
      height: 100vh;
      max-height: 850px;
      background: #ffffff;
      display: flex;
      flex-direction: column;
      position: relative;
      box-shadow: 0 0 20px rgba(0,0,0,0.1);
    }

    /* ヘッダー */
    header {
      padding: 8px 12px;
      border-bottom: 1px solid #e0e0e0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #fafafa;
      height: 52px;
    }

    .header-btn {
      background: #eee;
      border: 1px solid #ccc;
      font-size: 0.8rem;
      font-weight: 600;
      color: #333;
      cursor: pointer;
      padding: 6px 10px;
      border-radius: 6px;
      white-space: nowrap;
    }

    .header-btn:active { background: #ddd; }

    #header-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: #111;
      text-align: center;
      flex: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      margin: 0 6px;
    }

    /* ビューコンテナ */
    .view {
      flex: 1;
      display: flex;
      flex-direction: column;
      padding: 14px;
      overflow-y: auto;
    }

    .hidden { display: none !important; }

    /* 章選択画面 */
    .chapter-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .chapter-card {
      border: 2px solid #333;
      border-radius: 8px;
      padding: 12px;
      background: #fff;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .theme-1 { border-color: #2b5c8f; }
    .theme-2 { border-color: #3b7a57; }
    .theme-3 { border-color: #b85b14; }
    .theme-4 { border-color: #6b3ba7; }
    .theme-5 { border-color: #1b788a; }

    .chapter-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .chapter-title {
      font-size: 0.9rem;
      font-weight: 700;
      color: #111;
    }

    .chapter-count {
      font-size: 0.75rem;
      color: #666;
      background: #f0f0f0;
      padding: 2px 6px;
      border-radius: 4px;
    }

    .progress-container {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .progress-bar-bg {
      flex: 1;
      height: 8px;
      background: #e9ecef;
      border-radius: 4px;
      overflow: hidden;
    }

    .progress-bar-fill {
      height: 100%;
      background: #222;
      width: 0%;
      transition: width 0.3s ease;
    }

    .progress-text {
      font-size: 0.75rem;
      font-weight: 700;
      min-width: 36px;
      text-align: right;
    }

    .btn-group {
      display: flex;
      gap: 8px;
      margin-top: 4px;
    }

    .btn-start, .btn-review {
      flex: 1;
      padding: 8px 4px;
      border: none;
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.8rem;
      cursor: pointer;
      text-align: center;
    }

    .btn-start {
      background: #111;
      color: #fff;
    }

    .btn-review {
      background: #f0f0f0;
      color: #333;
      border: 1px solid #bbb;
    }

    .btn-start:active { opacity: 0.85; }
    .btn-review:active { background: #e0e0e0; }

    .btn-review:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    /* クイズ画面 */
    .quiz-header {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      color: #666;
      margin-bottom: 10px;
      font-weight: 600;
    }

    .question-box {
      background: #f8f9fa;
      border: 1px solid #e9ecef;
      border-radius: 8px;
      padding: 14px;
      font-size: 0.95rem;
      font-weight: 600;
      line-height: 1.5;
      color: #111;
      min-height: 90px;
      display: flex;
      align-items: center;
      margin-bottom: 14px;
    }

    .options-container {
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex: 1;
    }

    .btn-option {
      width: 100%;
      padding: 12px;
      background: #fff;
      border: 1.5px solid #ccc;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      color: #222;
      cursor: pointer;
      text-align: left;
    }

    .btn-option:active {
      background: #f0f0f0;
      border-color: #111;
    }

    .input-container {
      display: flex;
      flex-direction: column;
      gap: 12px;
      flex: 1;
    }

    .text-input {
      width: 100%;
      padding: 12px;
      border: 2px solid #333;
      border-radius: 8px;
      font-size: 1rem;
      outline: none;
    }

    .btn-submit {
      padding: 12px;
      background: #111;
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
    }

    #overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      background: rgba(255, 255, 255, 0.92);
      z-index: 100;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.15s ease;
    }

    #overlay.show { opacity: 1; }

    .mark { font-size: 6rem; line-height: 1; }

    .correct-ans-text {
      font-size: 1.1rem;
      font-weight: bold;
      color: #222;
      margin-top: 10px;
      text-align: center;
      padding: 0 16px;
    }

    .result-box {
      text-align: center;
      margin: auto 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }

    .result-score { font-size: 2.5rem; font-weight: 800; color: #111; }
    .result-desc { font-size: 0.9rem; color: #555; }
  </style>
</head>
<body>

<div id="app">
  <header>
    <button id="btn-home" class="header-btn" onclick="showChapterView()">🏠 ホーム</button>
    <h1 id="header-title">地学 一問一答</h1>
    <button id="btn-mode-toggle" class="header-btn" onclick="toggleMode()">モード: 4択</button>
  </header>

  <div id="overlay">
    <div id="overlay-mark" class="mark">⭕️</div>
    <div id="overlay-text" class="correct-ans-text"></div>
  </div>

  <div id="view-chapters" class="view">
    <div class="chapter-list" id="chapter-list"></div>
  </div>

  <div id="view-quiz" class="view hidden">
    <div class="quiz-header">
      <span id="quiz-chapter-name">章タイトル</span>
      <span id="quiz-progress-num">1 / 10</span>
    </div>
    <div class="question-box" id="quiz-question"></div>

    <div class="options-container" id="quiz-options"></div>

    <div class="input-container hidden" id="quiz-input-container">
      <input type="text" id="user-answer-input" class="text-input" placeholder="解答を入力..." autocomplete="off">
      <button class="btn-submit" onclick="submitWrittenAnswer()">回答する</button>
    </div>
  </div>

  <div id="view-result" class="view hidden">
    <div class="result-box">
      <h2>演習完了</h2>
      <div class="result-score" id="result-score-text">80%</div>
      <p class="result-desc" id="result-desc-text"></p>
      <button class="btn-start" style="padding: 12px 24px; width: auto;" onclick="showChapterView()">章一覧へ戻る</button>
    </div>
  </div>
</div>

<script>
  const quizData = [
    {
      id: "ch1",
      title: "プリント①：大気の構造",
      theme: "theme-1",
      questions: [
        { q: "乾燥空気の組成で、窒素(78%)に次いで2番目に体積比が大きい気体(21%)は何か？", ans: "酸素", dummy: ["二酸化炭素", "アルゴン", "水蒸気"] },
        { q: "乾燥空気の組成で、3番目に体積比が大きい気体(0.93%)は何か？", ans: "アルゴン", dummy: ["二酸化炭素", "ネオン", "ヘリウム"] },
        { q: "乾燥空気の組成で、4番目に体積比が大きい気体(約0.04%)は何か？", ans: "二酸化炭素", dummy: ["アルゴン", "メタン", "オゾン"] },
        { q: "1気圧（標準大気圧）と同等の水銀柱の高さは何cmか？", ans: "76cm", dummy: ["760cm", "101.3cm", "100cm"] },
        { q: "1気圧は何ヘクトパスカル(hPa)に相当するか？", ans: "1013hPa", dummy: ["1000hPa", "101325hPa", "760hPa"] },
        { q: "大気圧に関する公式「p = ρgh」において、ρは何を表すか？", ans: "密度", dummy: ["重力加速度", "高さ", "圧力"] },
        { q: "高度とともに気圧が減少する割合を表す、1/eになる高度（約8.5km）を何と呼ぶか？", ans: "スケールハイト", dummy: ["層頂高度", "露点標高", "限界標高"] },
        { q: "大気圏の最下層で、気象現象が起こる高度約11kmまでの層は何か？", ans: "対流圏", dummy: ["成層圏", "中間圏", "熱圏"] },
        { q: "対流圏と成層圏の境界となる面を何と呼ぶか？", ans: "対流圏界面", dummy: ["成層圏界面", "中間圏界面", "熱圏界面"] },
        { q: "高度とともに気温が上昇し、オゾン層が存在する層（高度11〜50km）は何か？", ans: "成層圏", dummy: ["対流圏", "中間圏", "熱圏"] },
        { q: "オゾン層が存在する高度は約何km〜何kmか？", ans: "20〜30km", dummy: ["10〜15km", "50〜80km", "80〜100km"] },
        { q: "高度とともに気温が低下し、大気圏中で最も気温が低い界面を持つ層（高度50〜80km）は何か？", ans: "中間圏", dummy: ["成層圏", "熱圏", "対流圏"] },
        { q: "流星が主に発光観測される大気の層はどこか？", ans: "中間圏", dummy: ["対流圏", "成層圏", "熱圏"] },
        { q: "高度とともに気温が著しく上昇し、オーロラが発生する層（高度80km以上）は何か？", ans: "熱圏", dummy: ["中間圏", "成層圏", "対流圏"] },
        { q: "太陽からの強い紫外線やX線により、気体分子がイオンと電子に電離している領域を何と呼ぶか？", ans: "電離層", dummy: ["オゾン層", "磁気圏", "対流圏"] }
      ]
    },
    {
      id: "ch2",
      title: "プリント②：大気中の水蒸気と雲",
      theme: "theme-2",
      questions: [
        { q: "水蒸気が凝結して水滴になるとき、または水が蒸発するときに出入りする状態変化の熱を何と呼ぶか？", ans: "潜熱", dummy: ["顕熱", "放射熱", "断熱熱"] },
        { q: "水蒸気の潜熱（蒸発熱・凝結熱）の値はおよそいくらか？", ans: "2.5×10^6 J/kg", dummy: ["3.3×10^5 J/kg", "1.0×10^3 J/kg", "4.2×10^3 J/kg"] },
        { q: "空気が含むことのできる最大限界の水蒸気圧を何と呼ぶか？", ans: "飽和水蒸気圧", dummy: ["相対湿度", "露点圧力", "凝結圧力"] },
        { q: "空気塊が冷却され、水蒸気圧が飽和水蒸気圧に達して凝結が始まる温度を何と呼ぶか？", ans: "露点", dummy: ["湿球温度", "絶対温度", "断熱温度"] },
        { q: "空気塊が周囲と熱のやり取りを行わずに膨張・凝縮する変化を何と呼ぶか？", ans: "断熱変化", dummy: ["等温変化", "定圧変化", "定積変化"] },
        { q: "未飽和の空気塊が上昇するとき、100mにつき約1℃低下する減率を何と呼ぶか？", ans: "乾燥断熱減率", dummy: ["湿潤断熱減率", "気温鉛直減率", "環境減率"] },
        { q: "飽和した空気塊が上昇するとき、潜熱放出により100mにつき約0.5℃低下する減率を何と呼ぶか？", ans: "湿潤断熱減率", dummy: ["乾燥断熱減率", "自由対流減率", "絶対安定減率"] },
        { q: "空気塊の上昇により水蒸気が凝結し始め、雲底が形成される高度を何と呼ぶか？", ans: "持ち上げ凝結高度", dummy: ["自由対流高度", "平衡高度", "対流界面高度"] },
        { q: "環境の気温減率が乾燥断熱減率より大きい場合の安定度はどれか？", ans: "絶対不安定", dummy: ["絶対安定", "条件付不安定", "中立"] },
        { q: "環境の気温減率が湿潤断熱減率より小さい場合の安定度はどれか？", ans: "絶対安定", dummy: ["絶対不安定", "条件付不安定", "中立"] },
        { q: "環境の気温減率が乾燥断熱減率と湿潤断熱減率の間にある場合の安定度はどれか？", ans: "条件付不安定", dummy: ["絶対安定", "絶対不安定", "中立"] },
        { q: "10種雲形のうち、最も高い高度（上層雲）に分類されるハネ雲・すじ雲の名称は何か？", ans: "巻雲", dummy: ["高層雲", "層雲", "積雲"] },
        { q: "10種雲形のうち、鉛直方向に著しく発達し、雷雨をもたらす入道雲の正称は何か？", ans: "積乱雲", dummy: ["高積雲", "乱層雲", "層積雲"] }
      ]
    },
    {
      id: "ch3",
      title: "プリント③：太陽放射と大気のエネルギー収支",
      theme: "theme-3",
      questions: [
        { q: "大気圏外で太陽光線に垂直な1m²の面が1秒間に受ける太陽放射エネルギー量（約1.36kW/m²）を何と呼ぶか？", ans: "太陽定数", dummy: ["アルベド", "放射収支", "地球放射"] },
        { q: "地球に入射する太陽放射に対する、宇宙へ反射・散乱される割合（約0.30）を何と呼ぶか？", ans: "アルベド", dummy: ["吸収率", "透過率", "放射率"] },
        { q: "太陽から放出される主要な波長帯の電磁波は何か？", ans: "可視光線", dummy: ["赤外線", "紫外線", "X線"] },
        { q: "地表や大気から放出される主要な波長帯の電磁波は何か？", ans: "赤外線", dummy: ["可視光線", "紫外線", "ガンマ線"] },
        { q: "物体の放射エネルギーが絶対温度の4乗に比例するという法則は何か？", ans: "シュテファン・ボルツマンの法則", dummy: ["ウィーンの変位則", "プランクの法則", "キルヒホッフの法則"] },
        { q: "地球のエネルギー収支において、入射する太陽放射100に対して大気・雲に吸収される割合はいくらか？", ans: "20", dummy: ["30", "50", "70"] },
        { q: "入射する太陽放射100に対して地表に吸収される割合はいくらか？", ans: "50", dummy: ["20", "30", "70"] },
        { q: "大気中の水蒸気や二酸化炭素などが地表からの赤外放射を吸収し、地表を保温する効果を何と呼ぶか？", ans: "温室効果", dummy: ["断熱効果", "アルベド効果", "シーリング効果"] },
        { q: "最も温室効果への寄与度が大きい大気中の気体は何か？", ans: "水蒸気", dummy: ["二酸化炭素", "メタン", "フロン"] },
        { q: "温室効果ガスの中で、人為的排出による影響が最も懸念されている気体は何か？", ans: "二酸化炭素", dummy: ["水蒸気", "一酸化二窒素", "オゾン"] }
      ]
    },
    {
      id: "ch4",
      title: "プリント④：風と大気の大循環",
      theme: "theme-4",
      questions: [
        { q: "気圧の高い方から低い方へ向かって働く、単位質量あたりの力を何と呼ぶか？", ans: "気圧傾度力", dummy: ["コリオリの力", "摩擦力", "遠心力"] },
        { q: "地球自転によって生じる、北半球で進行方向に対して右向きに働く見かけの力を何と呼ぶか？", ans: "コリオリの力", dummy: ["気圧傾度力", "摩擦力", "遠心力"] },
        { q: "緯度φ、地球自転角速度ωとしたとき、コリオリのパラメーターfはどのように表されるか？", ans: "2ωsinφ", dummy: ["ωsinφ", "2ωcosφ", "ωcosφ"] },
        { q: "上空で気圧傾度力とコリオリの力が釣り合って吹く風を何と呼ぶか？", ans: "地衝風", dummy: ["地上風", "傾圧風", "海陸風"] },
        { q: "地表付近で気圧傾度力、コリオリの力、および何が釣り合って等圧線を横切る風が吹くか？", ans: "摩擦力", dummy: ["遠心力", "浮力", "重力"] },
        { q: "赤道から緯度30度付近にかけて形成される南北方向の鉛直循環を何と呼ぶか？", ans: "ハドレー循環", dummy: ["フェレル循環", "極循環", "ウォーカー循環"] },
        { q: "緯度30度から60度付近の中緯度帯に存在する見かけ上の鉛直循環を何と呼ぶか？", ans: "フェレル循環", dummy: ["ハドレー循環", "極循環", "熱帯循環"] },
        { q: "ハドレー循環の地上付近で、赤道に向かって吹く恒常風（北半球では北東風）を何と呼ぶか？", ans: "貿易風", dummy: ["偏西風", "極偏東風", "季節風"] },
        { q: "中緯度帯の上空を西から東に向かって吹く強い風の帯を何と呼ぶか？", ans: "偏西風", dummy: ["貿易風", "極偏東風", "台風"] },
        { q: "対流圏上層の偏西風の中に存在する、特に風速が強い軸状の流れを何と呼ぶか？", ans: "ジェット気流", dummy: ["エルニーニョ", "上昇気流", "下降気流"] }
      ]
    },
    {
      id: "ch5",
      title: "プリント⑤：海水の運動と海洋大循環",
      theme: "theme-5",
      questions: [
        { q: "海水中にとけている塩分の中で最も高い割合（約78%）を占める物質は何か？", ans: "塩化ナトリウム", dummy: ["塩化マグネシウム", "硫酸マグネシウム", "硫酸カルシウム"] },
        { q: "海水1kg中に溶けている塩類の総量をグラム数で表した単位（‰またはPSU）を何と呼ぶか？", ans: "塩分", dummy: ["密度", "水温躍層", "濁度"] },
        { q: "海洋の鉛直構造で、太陽放射と風の混ざり合いにより水温・塩分がほぼ均一な最表層を何と呼ぶか？", ans: "表層混合層", dummy: ["水温躍層", "深層", "底層"] },
        { q: "表層混合層の下に位置し、深さとともに水温が急激に低下する層を何と呼ぶか？", ans: "水温躍層", dummy: ["表層混合層", "塩分躍層", "深層"] },
        { q: "風によって駆動される、海洋表層の海流循環を何と呼ぶか？", ans: "風成循環", dummy: ["熱塩循環", "深層循環", "潮汐循環"] },
        { q: "海面にかかる風の応力とコリオリの力により、表層の全海水が風の右直角方向（北半球）へ輸送される現象を何と呼ぶか？", ans: "エクマン輸送", dummy: ["地衝流輸送", "湧昇輸送", "沈降輸送"] },
        { q: "日本の太平洋沿岸を北上する代表的な温暖な強流（日本海流）の名称は何か？", ans: "黒潮", dummy: ["親潮", "対馬海流", "リマン海流"] },
        { q: "千島列島に沿って南下してくる冷たく栄養塩に富んだ親潮の別名は何か？", ans: "千島海流", dummy: ["日本海流", "対馬暖流", "東シナ海流"] },
        { q: "水温と塩分の違いによる海水の密度差によって駆動される全地球規模の深層循環を何と呼ぶか？", ans: "熱塩循環", dummy: ["風成循環", "沿岸湧昇", "潮汐流"] },
        { q: "熱塩循環の海水沈み込みが起こる代表的な北半球の海域はどこか？", ans: "グリーンランド沖（北大西洋高緯度）", dummy: ["赤道太平洋", "インド洋", "地中海"] }
      ]
    }
  ];

  let isMultipleChoice = true;
  let currentChapterIdx = 0;
  let currentQIdx = 0;
  let score = 0;
  let activeQuestions = [];
  let isReviewMode = false;

  const btnHome = document.getElementById('btn-home');
  const btnModeToggle = document.getElementById('btn-mode-toggle');
  const viewChapters = document.getElementById('view-chapters');
  const viewQuiz = document.getElementById('view-quiz');
  const viewResult = document.getElementById('view-result');
  const chapterListEl = document.getElementById('chapter-list');
  const quizOptionsContainer = document.getElementById('quiz-options');
  const quizInputContainer = document.getElementById('quiz-input-container');
  const userAnswerInput = document.getElementById('user-answer-input');
  const overlay = document.getElementById('overlay');
  const overlayMark = document.getElementById('overlay-mark');
  const overlayText = document.getElementById('overlay-text');

  function init() {
    renderChapterList();
    showChapterView();
  }

  function getWrongQuestions(chId) {
    const raw = localStorage.getItem(`wrong_q_${chId}`);
    return raw ? JSON.parse(raw) : [];
  }

  function saveWrongQuestions(chId, wrongArr) {
    localStorage.setItem(`wrong_q_${chId}`, JSON.stringify(wrongArr));
  }

  function getProgress(chId) {
    const p = localStorage.getItem(`prog_${chId}`);
    return p ? parseInt(p, 10) : 0;
  }

  function saveProgress(chId, percent) {
    localStorage.setItem(`prog_${chId}`, percent);
  }

  function toggleMode() {
    isMultipleChoice = !isMultipleChoice;
    btnModeToggle.innerText = isMultipleChoice ? "モード: 4択" : "モード: 記述";
    if (!viewQuiz.classList.contains('hidden')) {
      renderCurrentQuestionUI();
    }
  }

  function showChapterView() {
    renderChapterList();
    viewChapters.classList.remove('hidden');
    viewQuiz.classList.add('hidden');
    viewResult.classList.add('hidden');
    document.getElementById('header-title').innerText = "地学 一問一答";
  }

  function renderChapterList() {
    chapterListEl.innerHTML = '';
    quizData.forEach((ch, idx) => {
      const prog = getProgress(ch.id);
      const wrongList = getWrongQuestions(ch.id);

      const card = document.createElement('div');
      card.className = `chapter-card ${ch.theme}`;
      card.innerHTML = `
        <div class="chapter-header">
          <span class="chapter-title">${ch.title}</span>
          <span class="chapter-count">全 ${ch.questions.length} 問</span>
        </div>
        <div class="progress-container">
          <div class="progress-bar-bg">
            <div class="progress-bar-fill" style="width: ${prog}%"></div>
          </div>
          <span class="progress-text">${prog}%</span>
        </div>
        <div class="btn-group">
          <button class="btn-start" onclick="startQuiz(${idx}, false)">演習開始</button>
          <button class="btn-review" onclick="startQuiz(${idx}, true)" ${wrongList.length === 0 ? 'disabled' : ''}>
            復習 (${wrongList.length})
          </button>
        </div>
      `;
      chapterListEl.appendChild(card);
    });
  }

  function startQuiz(chapterIdx, reviewFlag) {
    currentChapterIdx = chapterIdx;
    isReviewMode = reviewFlag;
    currentQIdx = 0;
    score = 0;

    const ch = quizData[chapterIdx];
    if (isReviewMode) {
      const wrongIndices = getWrongQuestions(ch.id);
      activeQuestions = wrongIndices.map(i => ch.questions[i]);
    } else {
      activeQuestions = [...ch.questions];
    }

    shuffleArray(activeQuestions);

    viewChapters.classList.add('hidden');
    viewQuiz.classList.remove('hidden');
    viewResult.classList.add('hidden');
    document.getElementById('header-title').innerText = ch.title;

    loadQuestion();
  }

  function loadQuestion() {
    const q = activeQuestions[currentQIdx];
    document.getElementById('quiz-chapter-name').innerText = quizData[currentChapterIdx].title + (isReviewMode ? " (復習)" : "");
    document.getElementById('quiz-progress-num').innerText = `${currentQIdx + 1} / ${activeQuestions.length}`;
    document.getElementById('quiz-question').innerText = q.q;

    renderCurrentQuestionUI();
  }

  function renderCurrentQuestionUI() {
    const q = activeQuestions[currentQIdx];
    if (isMultipleChoice) {
      quizOptionsContainer.classList.remove('hidden');
      quizInputContainer.classList.add('hidden');
      quizOptionsContainer.innerHTML = '';

      const opts = [q.ans, ...q.dummy];
      shuffleArray(opts);

      opts.forEach(optText => {
        const btn = document.createElement('button');
        btn.className = 'btn-option';
        btn.innerText = optText;
        btn.onclick = () => checkAnswer(optText === q.ans, q.ans);
        quizOptionsContainer.appendChild(btn);
      });
    } else {
      quizOptionsContainer.classList.add('hidden');
      quizInputContainer.classList.remove('hidden');
      userAnswerInput.value = '';
      userAnswerInput.focus();
    }
  }

  function submitWrittenAnswer() {
    const q = activeQuestions[currentQIdx];
    const userAns = userAnswerInput.value.trim().toLowerCase();
    const correctAns = q.ans.trim().toLowerCase();

    const isCorrect = userAns === correctAns || (userAns.length > 1 && correctAns.includes(userAns));
    checkAnswer(isCorrect, q.ans);
  }

  function checkAnswer(isCorrect, correctAnsText) {
    const q = activeQuestions[currentQIdx];
    const ch = quizData[currentChapterIdx];
    const originalIdx = ch.questions.findIndex(item => item.q === q.q);

    let wrongList = getWrongQuestions(ch.id);

    if (isCorrect) {
      score++;
      overlayMark.innerText = "⭕️";
      overlayText.innerText = "";
      wrongList = wrongList.filter(i => i !== originalIdx);
    } else {
      overlayMark.innerText = "❌";
      overlayText.innerText = `正解: ${correctAnsText}`;
      if (!wrongList.includes(originalIdx) && originalIdx !== -1) {
        wrongList.push(originalIdx);
      }
    }
    saveWrongQuestions(ch.id, wrongList);

    overlay.classList.add('show');

    setTimeout(() => {
      overlay.classList.remove('show');
      currentQIdx++;
      if (currentQIdx < activeQuestions.length) {
        loadQuestion();
      } else {
        showResult();
      }
    }, isCorrect ? 500 : 1400);
  }

  function showResult() {
    const total = activeQuestions.length;
    const percent = Math.round((score / total) * 100);
    const ch = quizData[currentChapterIdx];

    if (!isReviewMode) {
      saveProgress(ch.id, percent);
    }

    document.getElementById('result-score-text').innerText = `${percent}%`;
    document.getElementById('result-desc-text').innerText = `正解数: ${score} / ${total} 問 (${isReviewMode ? '復習モード' : '通常演習'})`;

    viewQuiz.classList.add('hidden');
    viewResult.classList.remove('hidden');
  }

  function shuffleArray(arr) {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
  }

  userAnswerInput.addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
      submitWrittenAnswer();
    }
  });

  init();
</script>
</body>
</html>
